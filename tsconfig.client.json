{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": ["react"]
  },
  "include": ["src/client/**/*.ts", "src/ambient/**/*.d.ts"]
}
